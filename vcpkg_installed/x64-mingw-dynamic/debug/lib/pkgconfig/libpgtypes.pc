prefix=${pcfiledir}/../..
includedir=${prefix}/../include
libdir=${prefix}/lib

Name: libpgtypes
Description: PostgreSQL libpgtypes library
URL: https://www.postgresql.org/
Version: 18.4
Requires.private: zlib, liblz4, openssl
Libs: "-L${libdir}" -lpgtypes
Libs.private: -lws2_32 -lm "-L${libdir}" -lpgport_shlib -lpgcommon_shlib
Cflags: "-I${includedir}"

