prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/../include

Name: libpqxx
Description: C++ client API for the PostgreSQL database management system.
Version: 8.0.2
Requires.private: libpq
Libs: "-L${prefix}/lib" -lpqxx
Cflags: "-I${prefix}/../include"

